{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./*"],
      "@/*": ["./src/*"]
    },
    "typeRoots": ["./node_modules/@types", "./types"],
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}
